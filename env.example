# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Di Vercel, isi nilai yang sama pada Settings > Environment Variables.

# Connection string Neon (pilih "Pooled connection", berakhiran sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Kata sandi untuk masuk ke halaman admin (dashboard, impor Excel, QR)
ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat

# Teks acak panjang untuk menandatangani sesi login (minimal 32 karakter)
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# Opsional. Alamat dasar aplikasi untuk link dan QR, mis. https://spip-monitor.vercel.app
# Jika kosong, alamat diambil dari domain yang sedang diakses.
APP_URL=

